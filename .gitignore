# 敏感凭证与配置（公开仓库中绝对不能提交）
.github-token
.notify-config.json
.wx-config.json
.vscode/launch.json

# 部署专用 SSH 私钥（仅本机使用，禁止提交）
.deploy_key
.deploy_key.pub
DEPLOY_KEY_PUB.txt

# 个人脚本/无关文件
router-wol-schedule.sh

# 临时文件
*.log
*.tmp
# 原子写盘的临时文件必须带 .js 才能被 node --check 校验（node 22 拒绝未知扩展名），
# 所以 *.tmp 规则盖不住它，单独排除，否则 deploy.sh 的 git add -A 会把半成品推上去
*.tmp.js
.pipeline-*.lock
.pipeline-*.lock.stale-*
draft.json
.DS_Store
__pycache__/

# 打包与备份
market-dashboard.zip
*.bak
.playwright-cli/

# K 线抓取缓存（harmonic_detect/accumulation 脚本生成，TTL 20h，不应进仓库）
.kline_cache/

# 失败池状态文件（harmonic_detect / check_duanban 生成，运行时状态，不应进仓库）
.harmonic_state.json
.duanban_state.json

# 本地记忆层（工作区 .workbuddy/memory/：PROJECT-MEMORY.md + 56 份 归档-*.md 等）
# 内含家庭网络/路由器/油猴脚本等私有信息，且 deploy.sh 用 `git add -A`，
# 不排除会被误推进公开仓库 → 硬排除（记忆只在本地文件系统，不进 git）
.workbuddy/

# 一次性构建脚本（周末任务临时生成，不入库）
_weekend_*.py

# 个股公告抓取缓存（R100z148：check_duanban/retag_duanban 生成，TTL 当日，不应进仓库）
.notice_cache/

# 个股资讯搜索缓存（R100z149：stock_news.py 生成，TTL 当日，不应进仓库）
.news_cache/

# 通用运行时状态（R100z208：K9 环比基线 stocknews_stats.json / 告警 k9_alert.json）
# 是「随时间滚动的本机状态」，不是事实源；提交进仓库会让每次运行都产生 diff
.cache/
.bt_cache/
